{
  "name": "transub-desktop",
  "version": "0.1.0",
  "description": "Desktop subtitle transcription and translation app.",
  "author": "PiktCai",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron-vite dev --config vite.electron.config.ts",
    "electron:build": "tsc && electron-vite build --config vite.electron.config.ts",
    "build:server": "uv run --project .. --extra server --with pyinstaller pyinstaller --clean --onefile --paths .. --name transub-server --distpath resources --workpath build/transub-server --specpath build server_entry.py",
    "package": "npm run build:server && npm run electron:build && electron-builder --mac",
    "package:win": "npm run build:server && npm run electron:build && electron-builder --win",
    "package:linux": "npm run build:server && npm run electron:build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.transub.desktop",
    "productName": "Transub",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "icon": "assets/icon",
    "files": [
      "out/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": ["**/*"]
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo"
    }
  }
}
